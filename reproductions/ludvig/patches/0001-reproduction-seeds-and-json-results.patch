+def _max_dimension_downsample_resolution(orig_w, orig_h, resize_down):
+    orig = max(orig_w, orig_h)
+    if resize_down and orig > resize_down:
+        global_down = orig / resize_down
+        if orig_w >= orig_h:
+            return resize_down, int(orig_h / global_down)
