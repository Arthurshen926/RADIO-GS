\@writefile{toc}{\contentsline {section}{\numberline {I}Overview}{1}{section.1}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {II}Rendered-View Boundary Calibration}{1}{section.2}\protected@file@percent }
