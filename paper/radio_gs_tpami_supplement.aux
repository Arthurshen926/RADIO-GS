\@writefile{lot}{\contentsline {table}{\numberline {I}{\ignorespaces Label-free rendered-mask boundary calibration on the fixed LERF-OVS checkpoints. Threshold variants change only the peak-relative binary mask threshold. The final variant keeps threshold 0.60 and adds peak-connected-component filtering, which removes disconnected mask regions away from the query heatmap maximum. LocAcc is measured from the heatmap argmax before mask extraction.}}{2}{table.1}\protected@file@percent }
\newlabel{tab:rendered_boundary_calibration}{{I}{2}{Label-free rendered-mask boundary calibration on the fixed LERF-OVS checkpoints. Threshold variants change only the peak-relative binary mask threshold. The final variant keeps threshold 0.60 and adds peak-connected-component filtering, which removes disconnected mask regions away from the query heatmap maximum. LocAcc is measured from the heatmap argmax before mask extraction}{table.1}{}}
\@writefile{lot}{\contentsline {table}{\numberline {II}{\ignorespaces Multiview Primitive Registration controls for LERF-OVS direct 3D object selection. Except for the explicitly marked earlier raw-center variant, results use the same fixed top-2\% primitive selector. ``Reg.'' is the mean fraction of Gaussians receiving registered rendered-view features; unregistered primitives use the direct Gaussian-center fallback unless disabled by the ablation.}}{2}{table.2}\protected@file@percent }
\newlabel{tab:vpr_ablation}{{II}{2}{Multiview Primitive Registration controls for LERF-OVS direct 3D object selection. Except for the explicitly marked earlier raw-center variant, results use the same fixed top-2\% primitive selector. ``Reg.'' is the mean fraction of Gaussians receiving registered rendered-view features; unregistered primitives use the direct Gaussian-center fallback unless disabled by the ablation}{table.2}{}}
\@writefile{lot}{\contentsline {table}{\numberline {III}{\ignorespaces Multiview-registration-to-field consistency for LERF-OVS direct 3D object selection. All variants use the same softmax-threshold selector family, 0.5\% floor, 1.8\% cap, and label-free color-edge boundary calibration. Raw and registration-to-field variants report per-scene sweep-best thresholds; registered MPR reports the fixed \texttt  {thr0p25} paper result. Registration-to-field distills registered summary targets into the compact direct field and evaluates direct Gaussian-center scoring with a 0.5 residual blend to the original field. The confidence-weighted variant uses label-free log view-count weights from multiview registration.}}{3}{table.3}\protected@file@percent }
\newlabel{tab:vpr_field_consistency}{{III}{3}{Multiview-registration-to-field consistency for LERF-OVS direct 3D object selection. All variants use the same softmax-threshold selector family, 0.5\% floor, 1.8\% cap, and label-free color-edge boundary calibration. Raw and registration-to-field variants report per-scene sweep-best thresholds; registered MPR reports the fixed \texttt {thr0p25} paper result. Registration-to-field distills registered summary targets into the compact direct field and evaluates direct Gaussian-center scoring with a 0.5 residual blend to the original field. The confidence-weighted variant uses label-free log view-count weights from multiview registration}{table.3}{}}
\@writefile{lot}{\contentsline {table}{\numberline {IV}{\ignorespaces Direct3D mechanism audit using label-free multiview-registration coverage, primitive registered-score confidence, and text-margin ambiguity. Scene results report mean valid registered views; score-bucket results report mean top-1\% primitive text score; text-margin results report score margin against the strongest competing category.}}{3}{table.4}\protected@file@percent }
\newlabel{tab:direct3d_confidence_coverage}{{IV}{3}{Direct3D mechanism audit using label-free multiview-registration coverage, primitive registered-score confidence, and text-margin ambiguity. Scene results report mean valid registered views; score-bucket results report mean top-1\% primitive text score; text-margin results report score margin against the strongest competing category}{table.4}{}}
\@writefile{lot}{\contentsline {table}{\numberline {V}{\ignorespaces Query-level audit for LERF direct 3D object selection. Confidence intervals are bootstrap intervals over query masks for the fixed thr0p25 selector.}}{3}{table.5}\protected@file@percent }
\newlabel{tab:direct3d_query_audit}{{V}{3}{Query-level audit for LERF direct 3D object selection. Confidence intervals are bootstrap intervals over query masks for the fixed thr0p25 selector}{table.5}{}}
\@writefile{lot}{\contentsline {table}{\numberline {VI}{\ignorespaces Nearest-view frame-wise RADIO cache baseline on LERF-OVS. Each annotated target frame uses the closest cached RADIO feature map by camera-center distance, excluding the target frame itself; the feature map is not warped into the target camera.}}{4}{table.6}\protected@file@percent }
\newlabel{tab:nearest_view_cache_baseline}{{VI}{4}{Nearest-view frame-wise RADIO cache baseline on LERF-OVS. Each annotated target frame uses the closest cached RADIO feature map by camera-center distance, excluding the target frame itself; the feature map is not warped into the target camera}{table.6}{}}
\@writefile{lot}{\contentsline {table}{\numberline {VII}{\ignorespaces Per-Gaussian 1280-D explicit RADIO-memory baseline on LERF-OVS. Cached RADIO features are registered to Gaussian centers, stored as fp16 vectors, rendered to annotated views, and evaluated with the same frozen SigLIP2 scorer.}}{4}{table.7}\protected@file@percent }
\newlabel{tab:lerf_per_gaussian_1280d_baseline}{{VII}{4}{Per-Gaussian 1280-D explicit RADIO-memory baseline on LERF-OVS. Cached RADIO features are registered to Gaussian centers, stored as fp16 vectors, rendered to annotated views, and evaluated with the same frozen SigLIP2 scorer}{table.7}{}}
