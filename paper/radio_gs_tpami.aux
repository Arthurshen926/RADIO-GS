\@writefile{lot}{\contentsline {table}{\numberline {III}{\ignorespaces LERF-OVS direct 3D object selection under an OpenGaussian-style query-select-render protocol. External values are OpenGaussian official paper numbers. The registered multiview result uses primitive features transferred from posed rendered views. The compact-field result uses Gaussian-center primitive scores with an opacity-gated point adapter, a frozen SigLIP2 prompt ensemble, and label-free color-edge/score-component support calibration; it does not read a multiview-registration cache or official RGB SAM readout at inference, but it is not the strict no-RGB one-map ablation. The SAM3-box result is a frozen boundary readout after compact 3D primitive selection.}}{5}{table.3}\protected@file@percent }
\newlabel{tab:lerf-direct-3d-selection}{{III}{5}{LERF-OVS direct 3D object selection under an OpenGaussian-style query-select-render protocol. External values are OpenGaussian official paper numbers. The registered multiview result uses primitive features transferred from posed rendered views. The compact-field result uses Gaussian-center primitive scores with an opacity-gated point adapter, a frozen SigLIP2 prompt ensemble, and label-free color-edge/score-component support calibration; it does not read a multiview-registration cache or official RGB SAM readout at inference, but it is not the strict no-RGB one-map ablation. The SAM3-box result is a frozen boundary readout after compact 3D primitive selection}{table.3}{}}
\@writefile{lot}{\contentsline {table}{\numberline {IV}{\ignorespaces Compact Direct3D readout ablation. All variants use compact Gaussian-center primitive scores and the OpenGaussian-style query-select-render evaluation. The pure one-map variant is the strict no-registration-cache/no-RGB/no-SAM readout; guarded variants add label-free component support calibration but still avoid a multiview-registration cache and official RGB SAM decoder.}}{5}{table.4}\protected@file@percent }
\newlabel{tab:direct3d_compact_readout_ablation}{{IV}{5}{Compact Direct3D readout ablation. All variants use compact Gaussian-center primitive scores and the OpenGaussian-style query-select-render evaluation. The pure one-map variant is the strict no-registration-cache/no-RGB/no-SAM readout; guarded variants add label-free component support calibration but still avoid a multiview-registration cache and official RGB SAM decoder}{table.4}{}}
