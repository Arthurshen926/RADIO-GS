\@writefile{lot}{\contentsline {table}{\numberline {I}{\ignorespaces Quantitative evaluation of 2D and 3D open-vocabulary query on LERF-OVS. Baseline rows are published values reported by OpenGaFF and are included as source-paper context; the GaussFM{} rows are our locally auditable results. Because the readout protocols are not yet fully unified, this table is not a strict same-protocol ranking. We report mIoU and Acc in percent.}}{6}{table.1}\protected@file@percent }
\newlabel{tab:lerf_ovs_main}{{I}{6}{Quantitative evaluation of 2D and 3D open-vocabulary query on LERF-OVS. Baseline rows are published values reported by OpenGaFF and are included as source-paper context; the \method {} rows are our locally auditable results. Because the readout protocols are not yet fully unified, this table is not a strict same-protocol ranking. We report mIoU and Acc in percent}{table.1}{}}
\@writefile{lot}{\contentsline {table}{\numberline {II}{\ignorespaces LERF-OVS direct 3D open-vocabulary query. Baselines are published source-paper values; the GaussFM{} row is our locally auditable result. The readout protocols are not yet fully unified, so the external rows are context rather than a strict ranking. We report mIoU and Acc in percent.}}{6}{table.2}\protected@file@percent }
\newlabel{tab:lerf-direct-3d-selection}{{II}{6}{LERF-OVS direct 3D open-vocabulary query. Baselines are published source-paper values; the \method {} row is our locally auditable result. The readout protocols are not yet fully unified, so the external rows are context rather than a strict ranking. We report mIoU and Acc in percent}{table.2}{}}
\@writefile{lot}{\contentsline {table}{\numberline {III}{\ignorespaces Compact Direct3D readout ablation. All rows use compact Gaussian-center primitive scores and the OpenGaussian-style query-select-render evaluation. The pure one-map row is the strict no-VPR/no-RGB/no-SAM readout; guarded rows add GT-free component support policies but still avoid a VPR cache and official RGB SAM decoder.}}{6}{table.3}\protected@file@percent }
\newlabel{tab:direct3d_compact_readout_ablation}{{III}{6}{Compact Direct3D readout ablation. All rows use compact Gaussian-center primitive scores and the OpenGaussian-style query-select-render evaluation. The pure one-map row is the strict no-VPR/no-RGB/no-SAM readout; guarded rows add GT-free component support policies but still avoid a VPR cache and official RGB SAM decoder}{table.3}{}}
\@writefile{lot}{\contentsline {table}{\numberline {IV}{\ignorespaces Controlled same-evaluator comparison between original RADIO features extracted from RGB frames and GaussFM{} rendered features. Both use the same frozen SigLIP2 head, scene-category scoring, and label-free threshold-0.60 plus peak-connected-component mask conversion. This PCC-only comparison is separate from the final 2D OVS row in Table\nobreakspace  {}\ref  {tab:lerf_ovs_main}.}}{6}{table.4}\protected@file@percent }
\newlabel{tab:framewise_radio_vs_rendered}{{IV}{6}{Controlled same-evaluator comparison between original RADIO features extracted from RGB frames and \method {} rendered features. Both use the same frozen SigLIP2 head, scene-category scoring, and label-free threshold-0.60 plus peak-connected-component mask conversion. This PCC-only comparison is separate from the final 2D OVS row in Table~\ref {tab:lerf_ovs_main}}{table.4}{}}
