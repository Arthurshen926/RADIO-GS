  "mathematical_contract": {
    "stored_affinity": "a=(scene_centered_cosine+1)/2 in [0,1]",
    "likelihood_coordinate": "s=2a-1=scene_centered_cosine in [-1,1]",
    "positive_set_statistics": ["max(s_positive)", "mean(s_positive)"],
    "negative_set_statistics": ["max(s_negative)", "mean(s_negative)"],
    "raw_score": "ell=sum softplus(w_pos)*T(s_positive)-sum softplus(w_neg)*T(s_negative)",
    "bias": "fixed exact zero buffer and not trainable",
    "zero_evidence_neutrality": "empty observation sets or exact null cosine s=0 yield ell=0 and q=0.5 exactly",
    "monotonicity": "increasing positive cosine cannot lower ell; increasing negative cosine cannot raise ell",
    "dissimilarity_semantics": "negative signed cosine to a positive click is negative foreground evidence; negative signed cosine to a negative click is positive foreground evidence",
    "training_posterior": "sigmoid(ell+logit(pi_object))",
    "population_bce": "pi*mean_positive_BCE+(1-pi)*mean_negative_BCE over deterministic stratified rows",
    "ranking": "mean softplus(-(ell_positive-ell_negative))",
    "inference": "q=sigmoid(ell), c=coverage*reliability",
    "direct_solver_compilation": "T*logit((1-c)*0.5+c*q), with exact sigmoid(unary/T) identity",
    "hard_spatial_seed": "solver extent constraint only and never an instance likelihood feature"
  },
  "training_recipe": {
    "recipe_id": "capability-signed-null-likelihood-ratio-bce-prior-correction-rank025-adam-seed0-e100-lr0.02-v4",
