    "hard_seed_conflict_policy": "positive_priority",
    "final_anchor_identity": "hard positive q=1 and hard negative q=0 exactly; anchor confidence=1",
    "direct_solver_compilation": "T*logit((1-c)*0.5+c*q)",
    "graph_role": "instance extent only; it does not replace or recalibrate capability likelihood",
    "default_path": "apply_residual=false returns the base head evidence unchanged"
